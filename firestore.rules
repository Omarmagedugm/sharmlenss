rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Health check / connection test
    match /test/{docId} {
      allow read: if true;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'megastudiodm@gmail.com'
      );
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (getUserData().role == 'owner' || getUserData().role == 'admin')
      );
    }

    function isAccountant() {
      return isAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role == 'accountant'
      );
    }

    function isPhotographer() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role == 'photographer';
    }

    function getPhotographerId() {
      return getUserData().photographerId;
    }

    // USERS COLLECTION
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && (
        isBootstrappedAdmin() ||
        (request.auth.uid == userId && (!('role' in incoming()) || incoming().role == 'photographer')) ||
        isAdmin()
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phone', 'updatedAt']))
      );
      allow delete: if isAdmin();
    }

    // PHOTOGRAPHERS COLLECTION
    match /photographers/{photographerId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // BOATS COLLECTION
    match /boats/{boatId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // TRIPS COLLECTION
    match /trips/{tripId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isPhotographer() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['actualCustomers', 'status', 'notes', 'updatedAt'])
      );
    }

    // CUSTOMERS COLLECTION
    match /customers/{customerId} {
      // Public customer gallery can read customer by ID if gallery code is accessed
      allow read: if isSignedIn() || true;
      allow create: if isSignedIn();
      allow update: if isAdmin() || (
        isSignedIn() && (
          isPhotographer() && (existing().photographerId == getPhotographerId() || incoming().photographerId == getPhotographerId())
        )
      );
      allow delete: if isAdmin();
    }

    // PHOTOS COLLECTION
    match /photos/{photoId} {
      allow read: if isSignedIn() || true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() || true;
      allow delete: if isAdmin() || (
        isSignedIn() && isPhotographer() && existing().photographerId == getPhotographerId()
      );
    }

    // PACKAGES COLLECTION
    match /packages/{packageId} {
      allow read: if true; // Public for customer gallery package selection
      allow create, update, delete: if isAdmin();
    }

    // SALES COLLECTION
    match /sales/{saleId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAdmin() || (
        isAccountant() && incoming().diff(existing()).affectedKeys().hasOnly(['paymentStatus', 'paymentMethod', 'notes', 'updatedAt'])
      );
      allow delete: if isAdmin();
    }

    // PAYMENTS COLLECTION
    match /payments/{paymentId} {
      allow read: if isAccountant() || (
        isSignedIn() && isPhotographer() && existing().photographerId == getPhotographerId()
      );
      allow create, update, delete: if isAccountant();
    }

    // DAILY CLOSINGS COLLECTION
    match /dailyClosings/{closingId} {
      allow read: if isAccountant();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // SETTINGS COLLECTION
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // NOTIFICATIONS COLLECTION
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // AUDIT LOGS COLLECTION
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false; // Immutable audit log
    }
  }
}
